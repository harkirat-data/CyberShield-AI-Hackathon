# RabbitMQ / CloudAMQP connection URL
# Get yours at https://cloudamqp.com
CLOUDAMQP_URL=amqps://user:pass@host/vhost

# Gemini API key for RAG answers
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Gemini-powered deception responses. Disable to use deterministic local personas.
HONEYPOT_USE_GEMINI=true

# Safe development default. Use 0.0.0.0 only on an isolated decoy host/container.
HONEYPOT_BIND_HOST=127.0.0.1

# Start the five listeners with the FastAPI application.
HONEYPOT_AUTOSTART=false

# Listener overrides (useful when a development port is reserved locally).
HONEYPOT_SSH_PORT=2222
HONEYPOT_TELNET_PORT=2323
HONEYPOT_HTTP_PORT=8088
HONEYPOT_HTTPS_PORT=8443
HONEYPOT_MYSQL_PORT=33060

# Persistent telemetry and generated TLS certificate location.
HONEYPOT_DB_PATH=logs/cybershield_honeypot.db
HONEYPOT_CERT_DIR=logs/certs

# Endpoint for log collectors
CYBERSHIELD_API_URL=http://127.0.0.1:8000/api/v1/logs

# Per-session safety limits.
HONEYPOT_READ_TIMEOUT=90
HONEYPOT_AI_TIMEOUT=12
# Add jitter after generated responses so the decoy does not answer unrealistically fast.
HONEYPOT_MIN_RESPONSE_DELAY=1.25
HONEYPOT_MAX_RESPONSE_DELAY=2.75
HONEYPOT_SESSION_TIMEOUT=1800
HONEYPOT_MAX_SESSIONS_PER_IP=8
HONEYPOT_MAX_INTERACTIONS=64
HONEYPOT_MAX_INPUT_BYTES=16384
HONEYPOT_MAX_EVENT_PREVIEW=4096
HONEYPOT_MAX_AI_OUTPUT=2000

# Redis for conversation memory
REDIS_URL=redis://localhost:6379/0

# Security Alerting Integrations (Optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_MIN_RISK_SCORE=80
ALERT_MIN_SEVERITY=high
ALERT_DEDUPLICATION_WINDOW_SECONDS=300

