# ==============================================================================
# VALENS Autonomous SOC Engine - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ALERT CHANNELS (Discord & Slack Webhooks)
# ------------------------------------------------------------------------------
# Paste incoming webhook URLs here:
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Alert Channel Toggles (true / false)
DISCORD_ENABLED=true
SLACK_ENABLED=true
EMAIL_ENABLED=true

# Notification Dispatch Thresholds
ALERT_MIN_RISK_SCORE=85
ALERT_MIN_SEVERITY=high
ALERT_DEDUP_WINDOW=300

# ------------------------------------------------------------------------------
# 2. EMAIL ALERTS - Choose OPTION A (SMTP) or OPTION B (Email Webhook)
# ------------------------------------------------------------------------------

# OPTION A: Standard SMTP Relay (e.g., Gmail, Outlook, SendGrid, Amazon SES)
# For Gmail: Use an App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-soc-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=your-soc-email@gmail.com
ALERT_EMAIL_TO=soc-team@example.com

# OPTION B: Email Webhook Bridge (Zapier, Make.com, n8n, Pipedream, Resend)
# If you prefer an HTTP webhook that triggers an email instead of SMTP credentials:
# EMAIL_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXX/YYYYYY/

# ------------------------------------------------------------------------------
# 3. AI & INTEL ENGINES
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CHROMA_COLLECTION_NAME=valens_security_kb

# ------------------------------------------------------------------------------
# 4. DECEPTION & HONEYPOT GRID
# ------------------------------------------------------------------------------
HONEYPOT_BIND_HOST=0.0.0.0
HONEYPOT_AUTOSTART=true
PORT=8050
